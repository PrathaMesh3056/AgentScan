# AgentScan optional analysis provider keys.
# Analysis defaults to deterministic and sensitive classification.
# A key alone does not enable external calls: explicitly choose external mode,
# a provider/model and non_sensitive classification. Sensitive scans use
# deterministic checks or an installed offline local model.
# Local CLI/dashboard reads the selected named key from environment or local .env.
# Keep real values outside Git; never put them in a scan form/request/report.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as a Gemini key alias.

# Offline local analysis needs no provider key. Prepare installed weights first,
# configure Ollama with OLLAMA_NO_CLOUD=1 and independently restrict daemon egress.
# AGENTSCAN_LOCAL_MODEL_URL=http://127.0.0.1:11434
# AGENTSCAN_LOCAL_MODEL=ollama/llama3.2

# Optional REST API / worker deployment environment (not implicit .env loading).
# Both API and workers require administrator-injected credentials/settings.
# Service provider keys come from environment/secret manager only.
# AGENTSCAN_EXTERNAL_MODEL=gemini/AVAILABLE_MODEL_ID
# AGENTSCAN_REDIS_URL=redis://localhost:6379/0
# AGENTSCAN_DATABASE_URL=postgresql://agentscan:agentscan@localhost:5432/agentscan
# AGENTSCAN_JWT_PRIVATE_KEY_FILE=/run/secrets/agentscan-jwt.pem
# AGENTSCAN_DATA_KEY_FILE=/run/secrets/agentscan-data.key
# AGENTSCAN_ALLOWED_TARGET_HOSTS=agent.example.com
# AGENTSCAN_TENANT_CREDENTIALS_JSON=<administrator-provisioned tenant credentials>
# AGENTSCAN_TENANT_POLICIES_JSON=<origins, explicit CIDRs, quotas, model permissions>
# AGENTSCAN_RETENTION_DAYS=7
# No default signing/enrollment secrets. Model permissions default false.
# See docs/DATA_POLICY.md and docs/api.md for full setup and limitations.
