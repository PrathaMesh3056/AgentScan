{% extends "base.html.j2" %}

{% block title %}AgentScan AI Security Audit Report · {{ report.target_url }}{% endblock %}

{% block content %}
{% set policy_only = report.assessment_scope in ['factuality_policy', 'overreliance_response_inventory'] %}
{% set display_score = none if policy_only else report.score %}
{% macro agency_count(value, recognized) -%}
{{ value if recognized and value is integer and value >= 0 and value <= 1000 else 'Unavailable' }}
{%- endmacro %}
<!-- ==========================================
     EXECUTIVE HEADER & BRAND BANNER
     ========================================== -->
<div class="card" style="border-top: 5px solid #0f172a; padding: 24px; margin-bottom: 20px;">
    <div style="display: table; width: 100%;">
        <div style="display: table-cell; vertical-align: middle; width: 60px;">
            {% if logo_data_uri %}
            <img src="{{ logo_data_uri }}" alt="AgentScan" style="width: 52px; height: 52px; display: block; border-radius: 8px;" />
            {% else %}
            <div style="width: 52px; height: 52px; background-color: #0f172a; border-radius: 8px; color: #fff; font-size: 24px; font-weight: bold; text-align: center; line-height: 52px;">AS</div>
            {% endif %}
        </div>
        <div style="display: table-cell; vertical-align: middle; padding-left: 16px;">
            <div style="font-size: 11pt; font-weight: 800; letter-spacing: 1.5px; color: #0f172a; text-transform: uppercase;">
                AgentScan
            </div>
            <div style="font-size: 17pt; font-weight: 800; color: #0f172a; line-height: 1.2;">
                AI Agent Security Posture &amp; Vulnerability Audit Report
            </div>
            <div style="font-size: 8.5pt; color: #64748b; font-weight: 500; margin-top: 3px;">
                RECORDED ASSESSMENT EVIDENCE · OWASP LLM TOP 10 MAPPINGS
            </div>
        </div>
        <div style="display: table-cell; vertical-align: top; text-align: right; width: 180px;">
            <span class="badge badge-neutral" style="font-size: 8pt; padding: 4px 10px;">
                CONFIDENTIAL // RESTRICTED
            </span>
            <div style="font-size: 8pt; color: #94a3b8; margin-top: 6px;">
                Doc Ref: AS-{{ report.scan_id[:8].upper() }}
            </div>
        </div>
    </div>

    <!-- Metadata Grid -->
    <div style="display: table; width: 100%; margin-top: 20px; padding-top: 14px; border-top: 1px solid #e2e8f0; font-size: 8.5pt;">
        <div style="display: table-cell; width: 33.3%;">
            <strong style="color: #64748b; text-transform: uppercase; font-size: 7pt; letter-spacing: 0.5px; display: block;">Target Endpoint</strong>
            <span style="font-family: monospace; font-weight: 600; color: #0f172a;">{{ report.target_url }}</span>
        </div>
        <div style="display: table-cell; width: 33.3%;">
            <strong style="color: #64748b; text-transform: uppercase; font-size: 7pt; letter-spacing: 0.5px; display: block;">Framework &amp; Mode</strong>
            <span style="font-weight: 600; color: #0f172a;">{{ report.framework.value.title() if report.framework else 'Auto' }} · {{ report.scan_mode.value }} Mode</span>
        </div>
        <div style="display: table-cell; width: 33.3%; text-align: right;">
            <strong style="color: #64748b; text-transform: uppercase; font-size: 7pt; letter-spacing: 0.5px; display: block;">Audit Timestamp</strong>
            <span style="font-weight: 600; color: #0f172a;">{{ generated_at }}</span>
        </div>
    </div>
</div>

<!-- ==========================================
     EXECUTIVE SUMMARY & KEY METRICS PANEL
     ========================================== -->
<div style="display: table; width: 100%; margin-bottom: 20px;">
    <!-- Score Column -->
    <div style="display: table-cell; width: 36%; vertical-align: top; padding-right: 12px;">
        <div class="card" style="height: 100%; margin-bottom: 0; text-align: center; padding: 22px 16px; border-left: 5px solid {% if display_score is none %}#64748b{% elif display_score >= 80 %}#16a34a{% elif display_score >= 50 %}#d97706{% else %}#dc2626{% endif %};">
            <div style="font-size: 8.5pt; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #64748b;">
                AgentScan Score
            </div>
            <div style="font-size: 42pt; font-weight: 900; line-height: 1; margin: 10px 0; color: {% if display_score is none %}#475569{% elif display_score >= 80 %}#16a34a{% elif display_score >= 50 %}#d97706{% else %}#dc2626{% endif %};">
                {{ display_score if display_score is not none else 'N/A' }}<span style="font-size: 16pt; font-weight: 600; color: #94a3b8;">/100</span>
                {% if report.calibration and not report.calibration.passed %}
                <div style="color: var(--sev-critical); font-size: 11pt; font-weight: bold; margin-top: 4px;">[UNRELIABLE]</div>
                {% endif %}
            </div>

            <div>
                <span class="badge {% if display_score is none %}badge-neutral{% elif display_score >= 80 %}badge-low{% elif display_score >= 50 %}badge-medium{% else %}badge-critical{% endif %}" style="font-size: 8.5pt; padding: 4px 12px;">
                    {{ 'UNSCORED SCOPE' if policy_only else score_band }}
                </span>
            </div>

            <div style="margin-top: 14px; font-size: 8pt; color: #64748b; line-height: 1.4;">
                {% if report.status != 'COMPLETE' or display_score is none %}
                Coverage is {{ report.status|lower }}. An unavailable target score cannot establish safety.
                {% else %}
                This score summarizes finding weights within evaluated checks. It does not estimate attack resistance, detector accuracy or overall security.
                {% endif %}
            </div>
        </div>
    </div>

    <!-- KPI Matrix Column -->
    <div style="display: table-cell; width: 64%; vertical-align: top; padding-left: 4px;">
        <div class="card" style="height: 100%; margin-bottom: 0; padding: 18px 20px;">
            <div style="font-size: 9pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #0f172a; margin-bottom: 12px;">
                Executive Findings Summary
            </div>

            <!-- Severity Counters Grid -->
            <div style="display: table; width: 100%; text-align: center; margin-bottom: 16px;">
                <div style="display: table-cell; width: 20%; padding: 8px 4px; background: #fef2f2; border-radius: 6px; border: 1px solid #fca5a5;">
                    <div style="font-size: 16pt; font-weight: 800; color: #dc2626;">{{ report.critical_count }}</div>
                    <div style="font-size: 7.5pt; font-weight: 700; color: #991b1b; text-transform: uppercase;">Critical</div>
                </div>
                <div style="display: table-cell; width: 2%;"></div>
                <div style="display: table-cell; width: 20%; padding: 8px 4px; background: #fff7ed; border-radius: 6px; border: 1px solid #fdba74;">
                    <div style="font-size: 16pt; font-weight: 800; color: #ea580c;">{{ report.high_count }}</div>
                    <div style="font-size: 7.5pt; font-weight: 700; color: #9a3412; text-transform: uppercase;">High</div>
                </div>
                <div style="display: table-cell; width: 2%;"></div>
                <div style="display: table-cell; width: 20%; padding: 8px 4px; background: #fffbeb; border-radius: 6px; border: 1px solid #fde68a;">
                    <div style="font-size: 16pt; font-weight: 800; color: #d97706;">{{ report.medium_count }}</div>
                    <div style="font-size: 7.5pt; font-weight: 700; color: #92400e; text-transform: uppercase;">Medium</div>
                </div>
                <div style="display: table-cell; width: 2%;"></div>
                <div style="display: table-cell; width: 20%; padding: 8px 4px; background: #f0fdf4; border-radius: 6px; border: 1px solid #86efac;">
                    <div style="font-size: 16pt; font-weight: 800; color: #16a34a;">{{ report.low_count }}</div>
                    <div style="font-size: 7.5pt; font-weight: 700; color: #166534; text-transform: uppercase;">Low</div>
                </div>
                <div style="display: table-cell; width: 2%;"></div>
                <div style="display: table-cell; width: 20%; padding: 8px 4px; background: #f0fdf4; border-radius: 6px; border: 1px solid #bbf7d0;">
                    <div style="font-size: 16pt; font-weight: 800; color: #15803d;">{{ report.passed_count }}</div>
                    <div style="font-size: 7.5pt; font-weight: 700; color: #14532d; text-transform: uppercase;">Passed</div>
                </div>
            </div>

            <!-- Additional Execution Details -->
            <div style="display: table; width: 100%; font-size: 8.5pt; border-top: 1px solid #f1f5f9; padding-top: 10px;">
                <div style="display: table-cell; width: 50%;">
                    <span style="color: #64748b;">Attack Variants Executed:</span>
                    <strong style="color: #0f172a;">{{ report.tests_run }}</strong>
                </div>
                <div style="display: table-cell; width: 50%; text-align: right;">
                    <span style="color: #64748b;">Scan Duration:</span>
                    <strong style="color: #0f172a;">{{ "%.2f"|format(report.duration_seconds) if report.duration_seconds else "N/A" }}s</strong>
                </div>
            </div>
            {% if report.module_errors %}
            <div style="margin-top: 8px; padding: 6px 10px; background: #fff1f2; border-left: 3px solid #e11d48; border-radius: 4px; font-size: 8pt; color: #9f1239;">
                <strong>Notice:</strong> {{ report.module_errors | length }} execution or assessment diagnostic(s) were recorded. Review their scope and status below.
            </div>
            {% endif %}
        </div>
    </div>
</div>

<div class="card" style="margin-bottom: 20px;">
    <h2 style="font-size: 12pt; margin: 0 0 8px;">Assessment coverage and diagnostics</h2>
    <p>Status: <strong>{{ report.status }}</strong> · Evaluated {{ report.tests_run }} / {{ report.tests_selected }} selected tests · Scope: {{ report.assessment_scope }}</p>
    {% if report.status != 'COMPLETE' %}
    <p style="color: #92400e; font-size: 9pt;">This assessment is incomplete. Missing or failed checks cannot establish that the target is safe.</p>
    {% endif %}
    {% if report.module_outcomes %}
    <table style="width: 100%; border-collapse: collapse; font-size: 8pt; margin-top: 10px;">
        <thead><tr>
            <th style="text-align: left; padding: 7px; border-bottom: 1px solid #cbd5e1;">Module</th>
            <th style="text-align: left; padding: 7px; border-bottom: 1px solid #cbd5e1;">Status</th>
            <th style="text-align: left; padding: 7px; border-bottom: 1px solid #cbd5e1;">Evaluated / selected</th>
            <th style="text-align: left; padding: 7px; border-bottom: 1px solid #cbd5e1;">Scope and reason</th>
        </tr></thead>
        <tbody>
        {% for outcome in report.module_outcomes %}
        <tr>
            <td style="padding: 7px; border-bottom: 1px solid #e2e8f0; overflow-wrap: anywhere;">{{ outcome.get('module_name') or outcome.get('module_id') or 'Module' }}</td>
            <td style="padding: 7px; border-bottom: 1px solid #e2e8f0;">{{ outcome.get('status', 'UNVERIFIED') }}</td>
            <td style="padding: 7px; border-bottom: 1px solid #e2e8f0;">{{ outcome.get('executed_tests', 0) }} / {{ outcome.get('selected_tests', 0) }}</td>
            <td style="padding: 7px; border-bottom: 1px solid #e2e8f0; overflow-wrap: anywhere;">{{ outcome.get('assessment_scope', 'target') }}{% if outcome.get('reason') or outcome.get('error') %}: {{ outcome.get('reason') or outcome.get('error') }}{% endif %}</td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p style="font-size: 9pt; color: #64748b;">No module outcome records are available. Per-module coverage is unverified.</p>
    {% endif %}
    {% set agency = namespace(present=false, total=0, rows=[]) %}
    {% for outcome in report.module_outcomes if outcome is mapping and outcome.get('assessment_scope') == 'agency_proposal_inventory' %}
        {% set agency.present = true %}
        {% set observations = outcome.get('observations') %}
        {% if observations is sequence and observations is not string and observations is not mapping %}
            {% set agency.total = agency.total + observations|length %}
            {% set agency.rows = (agency.rows + observations[:10])[:10] %}
        {% endif %}
    {% endfor %}
    {% if agency.present %}
    <section data-agency-observation-panel style="margin-top: 16px;">
        <h3 style="font-size: 10pt; margin: 16px 0 8px;">Agency proposals and claims</h3>
        <p style="font-size: 8pt;">Target-reported intent only. These counts do not independently verify authorization, approval, tool execution or downstream effects. They do not establish attack success or resistance.</p>
        {% if agency.rows %}
        <table style="width: 100%; border-collapse: collapse; font-size: 8pt;">
            <caption>ATK-013 recorded claims per probe; impact unassessed</caption>
            <thead><tr>
                <th scope="col" style="text-align: left;">Probe</th><th scope="col" style="text-align: left;">Reported proposals</th>
                <th scope="col" style="text-align: left;">Malformed proposals</th><th scope="col" style="text-align: left;">Completion claims</th>
                <th scope="col" style="text-align: left;">Pending approval claims</th><th scope="col" style="text-align: left;">Proposal scan</th>
            </tr></thead>
            <tbody>
            {% for observation in agency.rows %}
                {% set entry = observation if observation is mapping else {} %}
                {% set recognized = entry.get('criterion_version') == 'atk013-agency-observation-2026-10-18' and entry.get('evidence_source') == 'target_reported_intent' %}
                <tr data-agency-observation-row>
                    <th scope="row" style="text-align: left; overflow-wrap: anywhere;">{{ entry.get('variant_id')[:80] if entry.get('variant_id') is string and entry.get('variant_id')|trim else 'Probe unavailable' }}</th>
                    <td>{{ agency_count(entry.get('reported_proposal_count'), recognized) }}</td>
                    <td>{{ agency_count(entry.get('malformed_proposal_count'), recognized) }}</td>
                    <td>{{ agency_count(entry.get('reported_completion_claim_count'), recognized) }}</td>
                    <td>{{ agency_count(entry.get('reported_approval_pending_count'), recognized) }}</td>
                    <td>{% if recognized and entry.get('proposal_scan_limit') is integer and entry.get('proposal_scan_limit') == 1000 and entry.get('proposal_scan_truncated') is boolean %}{{ 'Truncated' if entry.get('proposal_scan_truncated') else 'Within limit' }} · 1000 entries maximum{% else %}Unavailable{% endif %}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p style="font-size: 8pt;">No agency observation records are available. Missing records do not establish that the target is safe.</p>
        {% endif %}
        {% if agency.total > 10 %}<p style="font-size: 8pt;">Only the first 10 observation records are shown. Review the JSON report for additional records.</p>{% endif %}
        <p style="font-size: 8pt;">A pending-approval claim does not prove that approval was required or enforced. A completion claim does not prove an action occurred. Raw responses, tool names and arguments are omitted.</p>
    </section>
    {% endif %}
    {% set rag = namespace(present=false, total=0, rows=[]) %}
    {% for outcome in report.module_outcomes if outcome is mapping and outcome.get('assessment_scope') == 'rag_document_observation' %}
        {% set rag.present = true %}
        {% set observations = outcome.get('observations') %}
        {% if observations is sequence and observations is not string and observations is not mapping %}
            {% set rag.total = rag.total + observations|length %}
            {% set rag.rows = (rag.rows + observations[:8])[:8] %}
        {% endif %}
    {% endfor %}
    {% if rag.present %}
    <section data-rag-observation-panel style="margin-top: 16px;">
        <h3 style="font-size: 10pt; margin: 16px 0 8px;">RAG document response observations</h3>
        <p style="font-size: 8pt;">A receipt is target-reported correlation only. It cannot prove corpus insertion, retrieval ranking, source authenticity or false-fact endorsement. Corpus poisoning, causal attribution and downstream impact remain unassessed.</p>
        {% if rag.rows %}
        <table style="width: 100%; border-collapse: collapse; font-size: 8pt;">
            <caption>ATK-008 recorded document responses per probe; impact unassessed</caption>
            <thead><tr>
                <th scope="col" style="text-align: left;">Probe</th><th scope="col" style="text-align: left;">Receipt status</th>
                <th scope="col" style="text-align: left;">Seed indicator present</th><th scope="col" style="text-align: left;">Readable response text</th>
            </tr></thead>
            <tbody>
            {% for observation in rag.rows %}
                {% set entry = observation if observation is mapping else {} %}
                {% set recognized = entry.get('criterion_version') == 'atk008-document-observation-2026-10-18' and entry.get('evidence_source') == 'target_reported_document_response' %}
                {% set readable = recognized and entry.get('response_text_available') is boolean %}
                <tr data-rag-observation-row>
                    <th scope="row" style="text-align: left; overflow-wrap: anywhere;">{{ (entry.get('variant_id')|trim)[:80] if entry.get('variant_id') is string and entry.get('variant_id')|trim else 'Probe unavailable' }}</th>
                    <td>{{ entry.get('receipt_status') if recognized and entry.get('receipt_status') in ['correlated', 'missing', 'invalid', 'mismatched'] else 'Unavailable' }}</td>
                    <td>{% if readable and entry.get('response_text_available') and entry.get('seed_indicator_present') is boolean %}{{ 'Yes' if entry.get('seed_indicator_present') else 'No' }}{% else %}Unavailable{% endif %}</td>
                    <td>{% if readable %}{{ 'Yes' if entry.get('response_text_available') else 'No' }}{% else %}Unavailable{% endif %}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p style="font-size: 8pt;">No document observation records are available. Missing records do not establish that the target is safe.</p>
        {% endif %}
        {% if rag.total > 8 %}<p style="font-size: 8pt;">Only the first 8 observation records are shown. Review the JSON report for additional records.</p>{% endif %}
        <p style="font-size: 8pt;">A seed indicator is a text observation only. It does not prove the target accepted a false fact. Raw source documents, receipts and response text are omitted.</p>
    </section>
    {% endif %}
    {% set owned_rag = namespace(present=false, total=0, rows=[], counts=[]) %}
    {% for outcome in report.module_outcomes if outcome is mapping and outcome.get('assessment_scope') == 'owned_rag_lab' %}
        {% set owned_rag.present = true %}
        {% set observations = outcome.get('observations') %}
        {% set owned_rag.counts = owned_rag.counts + [outcome.get('rag_finding_count')] %}
        {% if observations is sequence and observations is not string and observations is not mapping %}
            {% set owned_rag.total = owned_rag.total + observations|length %}
            {% set owned_rag.rows = (owned_rag.rows + observations[:64])[:64] %}
        {% endif %}
    {% endfor %}
    {% if owned_rag.present %}
    <section data-owned-rag-panel style="margin-top: 16px;">
        <h3 style="font-size: 10pt; margin: 16px 0 8px;">Local RAG validation effects</h3>
        <p style="font-size: 8pt;">These effects apply only to the declared owned application fixture and its independently instrumented policy. They are excluded from customer findings and the customer security score. They are not remote attestation or evidence of general corpus poisoning, retrieval ranking or source authenticity.</p>
        {% for amount in owned_rag.counts %}<p style="font-size: 8pt;">{{ amount if amount is integer and amount >= 0 and amount <= 64 else 'Unavailable' }} owned fixture effect finding(s).</p>{% endfor %}
        {% if owned_rag.rows %}
        <table style="width: 100%; border-collapse: collapse; font-size: 8pt;">
            <caption>Owned fixture case outcomes; customer-agent efficacy remains unassessed</caption>
            <thead><tr>
                <th scope="col" style="text-align: left;">Case</th><th scope="col" style="text-align: left;">Declared local profile</th>
                <th scope="col" style="text-align: left;">Witness disposition</th><th scope="col" style="text-align: left;">Observed fixture effect</th>
                <th scope="col" style="text-align: left;">Evidence SHA256 prefix</th>
            </tr></thead>
            <tbody>
            {% set effects = {'answer_integrity_violation': 'Answer integrity violation', 'citation_policy_violation': 'Citation policy violation'} %}
            {% set dispositions = {'forbidden_effect': 'Forbidden effect recorded', 'assessed_no_effect': 'No forbidden effect observed', 'policy_rejected': 'Rejected by fixture policy'} %}
            {% for observation in owned_rag.rows %}
                {% set entry = observation if observation is mapping else {} %}
                {% set profile = entry.get('local_profile') %}
                {% set digest = entry.get('independent_evidence_sha256') %}
                {% set source_digest = entry.get('source_sha256') %}
                {% set response_digest = entry.get('response_sha256') %}
                {% set disposition = entry.get('witness_disposition') %}
                {% set effect = entry.get('local_effect') %}
                {% set valid = namespace(profile=profile is string and profile|length >= 1 and profile|length <= 64, digest=digest is string and digest|length == 64, source=source_digest is string and source_digest|length == 64, response=response_digest is string and response_digest|length == 64) %}
                {% if valid.profile %}{% for character in profile %}{% if character not in 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.-' %}{% set valid.profile = false %}{% endif %}{% endfor %}{% endif %}
                {% if valid.digest %}{% for character in digest %}{% if character not in 'abcdef0123456789' %}{% set valid.digest = false %}{% endif %}{% endfor %}{% endif %}
                {% if valid.source %}{% for character in source_digest %}{% if character not in 'abcdef0123456789' %}{% set valid.source = false %}{% endif %}{% endfor %}{% endif %}
                {% if valid.response %}{% for character in response_digest %}{% if character not in 'abcdef0123456789' %}{% set valid.response = false %}{% endif %}{% endfor %}{% endif %}
                {% set consistent = disposition is string and disposition in dispositions and ((disposition == 'forbidden_effect' and effect is string and effect in effects) or (disposition != 'forbidden_effect' and effect is none)) %}
                {% set recognized = entry.get('assessment_scope') == 'owned_rag_lab' and entry.get('criterion_version') == 'atk008-document-observation-2026-10-18' and entry.get('evidence_source') == 'target_reported_document_response' and valid.profile and valid.source and valid.response and valid.digest and consistent %}
                <tr data-owned-rag-row>
                    <th scope="row" style="text-align: left; overflow-wrap: anywhere;">{{ (entry.get('variant_id')|trim)[:80] if entry.get('variant_id') is string and entry.get('variant_id')|trim else 'Probe unavailable' }}</th>
                    <td>{{ profile if recognized else 'Unavailable' }}</td>
                    <td>{{ dispositions[disposition] if recognized else 'Unavailable' }}</td>
                    <td>{% if recognized %}{{ effects[effect] if effect is not none else 'No forbidden effect recorded' }}{% else %}Unavailable{% endif %}</td>
                    <td>{{ digest[:12] if recognized else 'Unavailable' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p style="font-size: 8pt;">No owned fixture evidence records are available. Missing records do not establish that a policy was enforced.</p>
        {% endif %}
        {% if owned_rag.total > 64 %}<p style="font-size: 8pt;">Only the first 64 owned fixture records are shown. Review the JSON report for additional records.</p>{% endif %}
        <p style="font-size: 8pt;">Owned fixture witnesses are independent of target-reported receipt correlation. Missing remote receipts do not invalidate a valid local witness. Raw documents, responses and evidence journals are omitted.</p>
    </section>
    {% endif %}
    {% set factuality = namespace(present=false, rows=[], total=0, counts=[]) %}
    {% set overreliance = namespace(present=false, rows=[], total=0) %}
    {% for outcome in report.module_outcomes if outcome is mapping and outcome.get('module_id') == 'ATK-009' %}
        {% set observations = outcome.get('observations') %}
        {% if outcome.get('assessment_scope') == 'factuality_policy' %}
            {% set factuality.present = true %}
            {% set factuality.counts = factuality.counts + [outcome.get('policy_finding_count')] %}
            {% if observations is sequence and observations is not string and observations is not mapping %}
                {% set factuality.total = factuality.total + observations|length %}
                {% set factuality.rows = (factuality.rows + observations[:32])[:32] %}
            {% endif %}
        {% elif outcome.get('assessment_scope') == 'overreliance_response_inventory' %}
            {% set overreliance.present = true %}
            {% if observations is sequence and observations is not string and observations is not mapping %}
                {% set overreliance.total = overreliance.total + observations|length %}
                {% set overreliance.rows = (overreliance.rows + observations[:8])[:8] %}
            {% endif %}
        {% endif %}
    {% endfor %}
    {% if factuality.present %}
    <section data-factuality-policy-panel style="margin: 16px 0;">
        <h3 style="font-size: 10pt;">Client-approved answer policy results</h3>
        <p style="font-size: 8pt;">These deterministic checks compare complete responses with client-approved exact answers. A mismatch is a policy result; factual truth, causal attribution and downstream security impact remain unassessed. Results are excluded from target vulnerability findings and security scores.</p>
        {% for amount in factuality.counts %}<p style="font-size: 8pt;">{{ amount if amount is integer and amount >= 0 and amount <= 32 else 'Unavailable' }} approved-answer policy mismatch(es).</p>{% endfor %}
        {% if factuality.rows %}
        <table style="width: 100%; border-collapse: collapse; font-size: 8pt;">
            <caption>ATK-009 exact-answer comparisons; factual truth unassessed</caption>
            <thead><tr><th scope="col">Case</th><th scope="col">Request arm</th><th scope="col">Policy result</th><th scope="col">Response SHA256 prefix</th></tr></thead>
            <tbody>
            {% for observation in factuality.rows %}
                {% set entry = observation if observation is mapping else {} %}
                {% set valid = namespace(identity=true, digests=true) %}
                {% set identity = entry.get('case_id') %}
                {% if identity is not string or identity|length < 1 or identity|length > 64 %}{% set valid.identity = false %}
                {% else %}{% for char in identity %}{% if char not in 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.-' %}{% set valid.identity = false %}{% endif %}{% endfor %}{% endif %}
                {% for key in ['baseline_sha256', 'question_sha256', 'request_sha256', 'response_sha256'] %}
                    {% set digest = entry.get(key) %}
                    {% if key == 'response_sha256' and digest is none %}
                    {% elif digest is not string or digest|length != 64 %}{% set valid.digests = false %}
                    {% else %}{% for char in digest %}{% if char not in '0123456789abcdef' %}{% set valid.digests = false %}{% endif %}{% endfor %}{% endif %}
                {% endfor %}
                {% set response_bytes = entry.get('response_bytes') %}
                {% set valid_bytes = response_bytes is none or (response_bytes is integer and response_bytes >= 0 and response_bytes <= 16777216) %}
                {% set arm_labels = {'neutral':'Neutral question', 'false_answer_pressure':'False-answer pressure'} %}
                {% set outcome_labels = {'expected_answer':'Matches approved answer', 'answer_mismatch':'Approved-answer mismatch', 'inconclusive':'Inconclusive'} %}
                {% set arm = entry.get('arm') %}{% set result = entry.get('outcome') %}
                {% set recognized = entry.get('assessment_scope') == 'factuality_policy' and entry.get('criterion_version') == 'atk009-factuality-exact-v1' and entry.get('evidence_source') == 'operator_approved_exact_answer_comparison' and entry.get('security_impact') == 'unassessed' and entry.get('causal_attribution_verified') is sameas false and valid.identity and valid.digests and valid_bytes and arm is string and arm in arm_labels and result is string and result in outcome_labels and (result == 'inconclusive' or (entry.get('response_sha256') is string and response_bytes is integer)) %}
                <tr data-factuality-policy-row><th scope="row">{{ identity if recognized else 'Unavailable' }}</th><td>{{ arm_labels[arm] if recognized else 'Unavailable' }}</td><td>{{ outcome_labels[result] if recognized else 'Unavailable' }}</td><td>{{ entry.get('response_sha256')[:12] if recognized and entry.get('response_sha256') is string else 'Unavailable' }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}<p style="font-size: 8pt;">No approved-answer observation records are available. Missing records do not establish that an answer policy was enforced.</p>{% endif %}
        {% if factuality.total > 32 %}<p style="font-size: 8pt;">Only the first 32 approved-answer records are shown. Review the JSON report for additional records.</p>{% endif %}
        <p style="font-size: 8pt;">Questions, approved answers, false answers and raw responses are omitted.</p>
    </section>
    {% endif %}
    {% if overreliance.present %}
    <section data-overreliance-inventory-panel style="margin: 16px 0;">
        <h3 style="font-size: 10pt;">Overreliance response inventory</h3>
        <p style="font-size: 8pt;">These legacy probes record readable text, seed indicators and target-reported tool proposals. Factual truth, tool execution, causal attribution and downstream impact remain unassessed. A text indicator does not prove hallucination or a security violation.</p>
        {% if overreliance.rows %}
        <table style="width: 100%; border-collapse: collapse; font-size: 8pt;">
            <caption>ATK-009 response observations; impact unassessed</caption>
            <thead><tr><th scope="col">Probe</th><th scope="col">Readable response text</th><th scope="col">Seed indicator present</th><th scope="col">Reported tool proposals</th></tr></thead>
            <tbody>
            {% for observation in overreliance.rows %}
                {% set entry = observation if observation is mapping else {} %}
                {% set recognized = entry.get('criterion_version') == 'atk009-response-inventory-v1' and entry.get('evidence_source') == 'target_reported_response' and entry.get('tool_execution_verified') is sameas false and entry.get('causal_attribution_verified') is sameas false and entry.get('downstream_impact') == 'unassessed' %}
                {% set identity = entry.get('variant_id') %}{% set readable = entry.get('response_text_available') %}{% set marker = entry.get('seed_indicator_present') %}{% set proposals = entry.get('reported_tool_proposal_count') %}
                <tr data-overreliance-inventory-row><th scope="row">{{ (identity|trim)[:80] if identity is string and identity|trim else 'Probe unavailable' }}</th><td>{{ 'Yes' if recognized and readable is sameas true else 'No' if recognized and readable is sameas false else 'Unavailable' }}</td><td>{{ 'Yes' if recognized and readable is sameas true and marker is sameas true else 'No' if recognized and readable is sameas true and marker is sameas false else 'Unavailable' }}</td><td>{{ proposals if recognized and proposals is integer and proposals >= 0 and proposals <= 100 else 'Unavailable' }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}<p style="font-size: 8pt;">No response inventory records are available. Missing records do not establish that the target is safe.</p>{% endif %}
        {% if overreliance.total > 8 %}<p style="font-size: 8pt;">Only the first 8 response inventory records are shown. Review the JSON report for additional records.</p>{% endif %}
        <p style="font-size: 8pt;">Raw responses and tool names or arguments are omitted. Use an approved baseline for exact-answer policy checks.</p>
    </section>
    {% endif %}
    {% for outcome in report.module_outcomes %}
    {% if outcome.get('assessment_scope') == 'mcp_catalog_policy' %}
    <h3 style="font-size: 10pt; margin: 16px 0 8px;">MCP catalog policy comparison</h3>
    <p style="font-size: 8pt;">{{ outcome.get('catalog_finding_count', 0) }} catalog policy findings. This snapshot is excluded from overall agent-security scoring. Tool execution, endpoint migration and later metadata changes remain unassessed.</p>
    {% for finding in outcome.get('catalog_findings', []) %}
    <p style="font-size: 8pt; overflow-wrap: anywhere;"><strong>{{ finding.get('severity') }}</strong>: {{ finding.get('description') }}</p>
    {% set meta = finding.get('metadata', {}) %}
    <p style="font-size: 8pt;">Deviation counts: {{ meta.get('deviation_counts', {}) }}{% if meta.get('truncated') %}. Detail list truncated; all deviations are counted.{% endif %}</p>
    <table style="width: 100%; border-collapse: collapse; font-size: 8pt;">
        <thead><tr><th style="text-align: left;">Tool</th><th style="text-align: left;">Policy deviation</th><th style="text-align: left;">Metadata hashes</th></tr></thead>
        <tbody>{% for deviation in meta.get('deviations', []) %}
        <tr><td style="overflow-wrap: anywhere;">{{ deviation.get('name') }}</td><td>{{ deviation.get('kind') }}</td><td style="overflow-wrap: anywhere;">Expected: {{ deviation.get('expected_sha256', 'not enrolled') }}<br>Observed: {{ deviation.get('observed_sha256', 'not advertised') }}</td></tr>
        {% endfor %}</tbody>
    </table>
    {% endfor %}
    {% endif %}
    {% if outcome.get('consumer_findings') %}
    <h3 style="font-size: 10pt; margin: 16px 0 8px;">Local consumer effects: {{ outcome.get('consumer_finding_count', 0) }}</h3>
    <p style="font-size: 8pt;">Scope: {{ outcome.get('assessment_scope') }}. These owned fixture results are excluded from customer target findings and scores.</p>
    {% for finding in outcome.get('consumer_findings', []) %}
    <p style="font-size: 8pt; overflow-wrap: anywhere;"><strong>{{ finding.get('severity') }}</strong>: {{ finding.get('description') }}<br>{{ finding.get('evidence') }}</p>
    {% endfor %}
    {% endif %}
    {% endfor %}
    {% if report.module_errors %}
    <h3 style="font-size: 10pt; margin: 16px 0 8px;">Recorded assessment diagnostics ({{ report.module_errors | length }})</h3>
    <table style="width: 100%; border-collapse: collapse; font-size: 8pt;">
        <thead><tr>
            <th style="text-align: left; padding: 7px; border-bottom: 1px solid #cbd5e1;">Module</th>
            <th style="text-align: left; padding: 7px; border-bottom: 1px solid #cbd5e1;">Error</th>
        </tr></thead>
        <tbody>
        {% for error in report.module_errors %}
        <tr>
            <td style="padding: 7px; border-bottom: 1px solid #e2e8f0; overflow-wrap: anywhere;">{{ error.get('module_name') or error.get('module_id') or 'Module' }}</td>
            <td style="padding: 7px; border-bottom: 1px solid #e2e8f0; overflow-wrap: anywhere;">{{ error.get('error') or 'Execution error; review the JSON report for details.' }}</td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
    {% endif %}
</div>

<!-- ==========================================
     BEHAVIORAL POSTURE (SSP) & TRUST VALIDATION
     ========================================== -->
<div style="display: table; width: 100%; margin-bottom: 20px;">
    <!-- SSP Classification -->
    <div style="display: table-cell; width: 50%; vertical-align: top; padding-right: 8px;">
        <div class="card" style="height: 100%; margin-bottom: 0;">
            <div style="font-size: 9pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #0f172a; margin-bottom: 8px;">
                SSP Behavioral Classification
            </div>
            {% if report.ssp_class %}
                <p><strong>SSP class:</strong> {{ report.ssp_class.value.title() }}
                    {% if report.ssp_class.value == 'SERVANT' %}(explicit tool use only)
                    {% elif report.ssp_class.value == 'STALKER' %}(unsolicited read-only / probe actions)
                    {% elif report.ssp_class.value == 'PREDATOR' %}(autonomous side-effecting actions)
                    {% endif %}
                </p>
                <div style="margin-top: 6px;">
                    <span class="badge {% if report.ssp_class.value == 'SERVANT' %}badge-low{% elif report.ssp_class.value == 'STALKER' %}badge-medium{% else %}badge-critical{% endif %}" style="font-size: 8pt; padding: 3px 8px;">
                        Profile: {{ report.ssp_class.value }}
                    </span>
                </div>
            {% else %}
                <p style="font-size: 8.5pt; color: #94a3b8; font-style: italic;">SSP trajectory classification was not evaluated for this scan.</p>
            {% endif %}
        </div>
    </div>

    <!-- Trust & Calibration -->
    <div style="display: table-cell; width: 50%; vertical-align: top; padding-left: 8px;">
        <div class="trust-validation-section card" style="height: 100%; margin-bottom: 0; border-left: 4px solid {% if report.calibration and not report.calibration.passed %}var(--sev-critical){% else %}var(--sev-pass){% endif %};">
            <div style="font-size: 9pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #0f172a; margin-bottom: 8px;">
                Trust &amp; Validation
            </div>
            {% if report.calibration %}
                {% if report.calibration.passed %}
                    <p style="color: var(--sev-pass); font-weight: bold; margin-bottom: 5px;">Attacker validated against control ✓</p>
                    {% if report.calibration.detail %}
                    <p style="color: var(--text-muted); font-size: 8.5pt; margin-bottom: 5px;">{{ report.calibration.detail }}</p>
                    {% endif %}
                {% else %}
                    <p style="color: var(--sev-critical); font-weight: bold; margin-bottom: 5px;">⚠ Attacker NOT validated: {{ report.calibration.detail }} (Score is UNRELIABLE)</p>
                {% endif %}
            {% else %}
                <p style="color: var(--text-muted); font-size: 8.5pt; margin: 0;">Deterministic rule-based evaluation suite applied.</p>
            {% endif %}

            {% if report.attacker_config %}
                <p style="margin-top: 10px; font-size: 8.5pt;">
                    <strong>Attack Depth:</strong>
                    {% set ai_hits = report.findings | selectattr("attack_id", "equalto", "ATK-050") | list %}
                    {% set ai_coverage = namespace(evaluated=false) %}
                    {% for outcome in report.module_outcomes %}
                    {% if outcome.get('module_id') == 'ATK-050' and outcome.get('status') == 'COMPLETE' and outcome.get('executed_tests', 0) > 0 %}
                    {% set ai_coverage.evaluated = true %}
                    {% endif %}
                    {% endfor %}
                    {% if ai_hits %}ATK-050 finding recorded{% elif ai_coverage.evaluated %}No ATK-050 finding in evaluated tests{% else %}Unassessed{% endif %} [{{ report.attacker_config.model }} · {{ report.attacker_config.turns }} turns · {{ report.attacker_config.goal }}]
                </p>
                {% if report.attacker_config.escalation_model %}
                <p style="margin-top: 5px;"><small><strong>Escalation Model:</strong> {{ report.attacker_config.escalation_model }}</small></p>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>

<!-- ==========================================
     REGULATORY & COMPLIANCE ALIGNMENT
     ========================================== -->
<div class="card" style="margin-bottom: 24px;">
    <div style="font-size: 10pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #0f172a; margin-bottom: 10px;">
        Regulatory &amp; Standards Alignment Matrix
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th style="width: 25%;">Framework / Standard</th>
                <th style="width: 75%;">Mapped Articles, Functions &amp; Control Objectives</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><strong>EU AI Act</strong></td>
                <td>
                    {% if compliance_summary.eu_ai_act_article %}
                        {% for art in compliance_summary.eu_ai_act_article %}
                            <span class="badge badge-primary" style="margin-right: 4px; margin-bottom: 4px;">{{ art }}</span>
                        {% endfor %}
                    {% else %}
                        <span style="color: #94a3b8; font-style: italic;">No specific compliance violations mapped.</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td><strong>NIST AI RMF 1.0</strong></td>
                <td>
                    {% if compliance_summary.nist_function %}
                        {% for func in compliance_summary.nist_function %}
                            <span class="badge badge-primary" style="margin-right: 4px; margin-bottom: 4px;">{{ func }}</span>
                        {% endfor %}
                    {% else %}
                        <span style="color: #94a3b8; font-style: italic;">No specific compliance violations mapped.</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td><strong>MITRE ATLAS</strong></td>
                <td>
                    {% if compliance_summary.mitre_atlas_technique %}
                        {% for tech in compliance_summary.mitre_atlas_technique %}
                            <span class="badge badge-neutral" style="margin-right: 4px; margin-bottom: 4px;">{{ tech }}</span>
                        {% endfor %}
                    {% else %}
                        <span style="color: #94a3b8; font-style: italic;">No specific techniques detected.</span>
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- ==========================================
     DETAILED TECHNICAL FINDINGS DOSSIER
     ========================================== -->
<div style="margin-bottom: 16px;">
    <div style="font-size: 13pt; font-weight: 800; color: #0f172a; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 16px;">
        Detailed Technical Findings Dossier ({{ report.findings | length }})
    </div>

    {% if report.findings %}
        {% for finding in report.findings %}
        <div class="card avoid-break" style="margin-bottom: 16px; border-left: 4px solid {% if finding.severity.value == 'CRITICAL' %}#dc2626{% elif finding.severity.value == 'HIGH' %}#ea580c{% elif finding.severity.value == 'MEDIUM' %}#d97706{% elif finding.severity.value == 'LOW' %}#16a34a{% else %}#0284c7{% endif %};">
            <!-- Header Row -->
            <div style="display: table; width: 100%; margin-bottom: 8px;">
                <div style="display: table-cell; vertical-align: middle;">
                    <span style="font-family: monospace; font-size: 9pt; font-weight: 700; color: #64748b;">{{ finding.attack_id }}</span>
                    <strong style="font-size: 11pt; color: #0f172a; margin-left: 8px;">{{ finding.attack_name }}</strong>
                </div>
                <div style="display: table-cell; vertical-align: middle; text-align: right;">
                    {% if finding.owasp_id %}
                    <span class="badge badge-neutral" style="margin-right: 6px;">{{ finding.owasp_id }}</span>
                    {% endif %}
                    <span class="badge badge-{{ finding.severity.value.lower() }}">{{ finding.severity.value }}</span>
                </div>
            </div>

            <!-- Finding Description -->
            <div style="font-size: 9.5pt; color: #1e293b; margin-bottom: 10px; line-height: 1.45;">
                {{ finding.description }}
            </div>

            <!-- Evidence Section -->
            {% if finding.evidence %}
            <div style="margin-top: 10px;">
                <div style="font-size: 7.5pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; margin-bottom: 2px;">
                    Observed Proof of Concept / Evidence:
                </div>
                <pre class="code-block">{{ finding.evidence }}</pre>
            </div>
            {% endif %}

            <!-- Payload Used -->
            {% if finding.payload_used %}
            <div style="margin-top: 8px;">
                <div style="font-size: 7.5pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; margin-bottom: 2px;">
                    Triggering Payload:
                </div>
                <pre class="code-block" style="background-color: #1e293b;">{{ finding.payload_used }}</pre>
            </div>
            {% endif %}

            <!-- Remediation -->
            {% if finding.remediation %}
            <div style="margin-top: 10px; padding: 10px 12px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px;">
                <div style="font-size: 7.5pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #0284c7; margin-bottom: 3px;">
                    Recommended Strategic Remediation:
                </div>
                <div style="font-size: 8.5pt; color: #334155;">
                    {{ finding.remediation }}
                </div>
            </div>
            {% endif %}
        </div>
        {% endfor %}
    {% else %}
    <div class="card" style="text-align: center; padding: 36px 20px;">
        <div style="font-size: 12pt; font-weight: 700; color: #0f172a;">No target findings recorded</div>
        <p style="font-size: 9pt; color: #64748b; margin-top: 4px;">No findings to report.</p>
        <p style="font-size: 9pt; color: #64748b;">Status: {{ report.status }}. Review evaluated and selected coverage above. This result does not establish safety or certify security.</p>
    </div>
    {% endif %}
</div>

<div class="card avoid-break" style="padding: 16px; margin-top: 24px; font-size: 8pt; color: #64748b;">
    <strong>Assessment provenance</strong>
    <p>AgentScan engine v{{ report.agentscan_version }}. Assessment status: {{ report.status }}.</p>
    <p>This HTML/PDF artifact has no independently verified signature state here. It is not a security certification. Separately exported audit certificates apply only to the exact artifact they sign.</p>
</div>
{% endblock %}
