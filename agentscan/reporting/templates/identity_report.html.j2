{% extends "base.html.j2" %}

{% block title %}AgentScan {{ report.assessment_label }} Report{% endblock %}

{% block content %}
<!-- ==========================================
     EXECUTIVE HEADER & BRAND BANNER
     ========================================== -->
<div class="card" style="border-top: 5px solid #0f172a; padding: 24px; margin-bottom: 20px;">
    <div style="display: table; width: 100%;">
        <div style="display: table-cell; vertical-align: middle; width: 60px;">
            {% if logo_data_uri %}
            <img src="{{ logo_data_uri }}" alt="AgentScan" style="width: 52px; height: 52px; display: block; border-radius: 8px;" />
            {% else %}
            <div style="width: 52px; height: 52px; background-color: #0f172a; border-radius: 8px; color: #fff; font-size: 24px; font-weight: bold; text-align: center; line-height: 52px;">AS</div>
            {% endif %}
        </div>
        <div style="display: table-cell; vertical-align: middle; padding-left: 16px;">
            <div style="font-size: 11pt; font-weight: 800; letter-spacing: 1.5px; color: #0f172a; text-transform: uppercase;">
                AgentScan
            </div>
            <div style="font-size: 17pt; font-weight: 800; color: #0f172a; line-height: 1.2;">
                {{ report.assessment_label }} Report
            </div>
            <div style="font-size: 8.5pt; color: #64748b; font-weight: 500; margin-top: 3px;">
                STATIC AUDIT · COVERAGE-QUALIFIED FINDINGS · RUNTIME BEHAVIOUR NOT ASSESSED
            </div>
        </div>
        <div style="display: table-cell; vertical-align: top; text-align: right; width: 180px;">
            <span class="badge badge-neutral" style="font-size: 8pt; padding: 4px 10px;">
                CONFIDENTIAL // RESTRICTED
            </span>
            <div style="font-size: 8pt; color: #94a3b8; margin-top: 6px;">
                Doc Ref: AS-RBAC-AUDIT
            </div>
        </div>
    </div>

    <!-- Metadata Grid -->
    <div style="display: table; width: 100%; margin-top: 20px; padding-top: 14px; border-top: 1px solid #e2e8f0; font-size: 8.5pt;">
        <div style="display: table-cell; width: 40%;">
            <strong style="color: #64748b; text-transform: uppercase; font-size: 7pt; letter-spacing: 0.5px; display: block;">Scope</strong>
            <span style="font-weight: 600; color: #0f172a;">{{ report.assessment_label }}</span>
        </div>
        <div style="display: table-cell; width: 35%;">
            <strong style="color: #64748b; text-transform: uppercase; font-size: 7pt; letter-spacing: 0.5px; display: block;">Assessment</strong>
            <span style="font-weight: 600; color: #0f172a;">{{ report.status }} · {{ report.coverage_summary }}</span>
        </div>
        <div style="display: table-cell; width: 25%; text-align: right;">
            <strong style="color: #64748b; text-transform: uppercase; font-size: 7pt; letter-spacing: 0.5px; display: block;">Audit Timestamp</strong>
            <span style="font-weight: 600; color: #0f172a;">{{ generated_at }}</span>
        </div>
    </div>
</div>

{% if report.audit_coverage %}
<!-- ==========================================
     EXPLICIT MODULE COVERAGE
     ========================================== -->
<div class="card" style="margin-bottom: 20px; padding: 18px 20px;">
    <div style="display: table; width: 100%; margin-bottom: 8px;">
        <div style="display: table-cell; vertical-align: middle; font-size: 10pt; font-weight: 800; color: #0f172a;">
            Audit Coverage ({{ report.coverage_summary }})
        </div>
        <div style="display: table-cell; vertical-align: middle; text-align: right;">
            <span class="badge {% if report.status == 'COMPLETE' %}badge-low{% elif report.status == 'NOT_ASSESSED' %}badge-neutral{% else %}badge-medium{% endif %}" style="font-size: 8pt; padding: 4px 10px;">
                {{ report.status }}
            </span>
        </div>
    </div>
    <div style="font-size: 8.5pt; color: #64748b; margin-bottom: 12px;">
        {{ report.coverage_scope_note }}
        Modules marked SKIPPED were not selected for this run and are not part of the result.
    </div>
    <table class="data-table" style="margin-top: 0;">
        <thead>
            <tr>
                <th style="width: 26%;">Module</th>
                <th style="width: 13%;">Status</th>
                <th style="width: 9%;">Checks</th>
                <th style="width: 52%;">Source / limitation</th>
            </tr>
        </thead>
        <tbody>
            {% for item in report.audit_coverage %}
            <tr>
                <td>
                    <code>{{ item.module }}</code>
                    {% if item.label %}<span style="color: #94a3b8; font-size: 8pt;">({{ item.label }})</span>{% endif %}
                </td>
                <td>
                    <span class="badge {% if item.status == 'COMPLETE' %}badge-low{% elif item.status == 'SKIPPED' %}badge-neutral{% elif item.status == 'ERROR' %}badge-critical{% else %}badge-medium{% endif %}" style="font-size: 7.5pt;">
                        {{ item.status }}
                    </span>
                </td>
                <td>{{ item.checks_run | default(0) }}</td>
                <td style="font-size: 8pt; color: #475569;">
                    {{ item.source | default("") }}
                    {% if item.limitations %} — {{ item.limitations | join("; ") }}{% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% if report.module_errors %}
    <div style="margin-top: 12px; padding: 10px 12px; background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 6px;">
        <div style="font-size: 7.5pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #b91c1c; margin-bottom: 4px;">Modules that errored (not assessed)</div>
        {% for error in report.module_errors %}
        <div style="font-size: 8.5pt; color: #7f1d1d;"><strong>{{ error.module_name }}</strong>: {{ error.error }}</div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endif %}

<!-- ==========================================
     EXECUTIVE SCORE & OVERVIEW
     ========================================== -->
<div style="display: table; width: 100%; margin-bottom: 20px;">
    <div style="display: table-cell; width: 36%; vertical-align: top; padding-right: 12px;">
        <div class="card" style="height: 100%; margin-bottom: 0; text-align: center; padding: 22px 16px; border-left: 5px solid {% if report.identity_score is none %}#64748b{% elif report.identity_score >= 80 %}#16a34a{% elif report.identity_score >= 50 %}#d97706{% else %}#dc2626{% endif %};">
            <div style="font-size: 8.5pt; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #64748b;">
                {{ report.score_label }}
            </div>
            <div style="font-size: 42pt; font-weight: 900; line-height: 1; margin: 10px 0; color: {% if report.identity_score is none %}#64748b{% elif report.identity_score >= 80 %}#16a34a{% elif report.identity_score >= 50 %}#d97706{% else %}#dc2626{% endif %};">
                {{ report.identity_score if report.identity_score is not none else "N/A" }}{% if report.identity_score is not none %}<span style="font-size: 16pt; font-weight: 600; color: #94a3b8;">/100</span>{% endif %}
            </div>
            <div>
                <span class="badge {% if report.identity_score is none %}badge-info{% elif report.identity_score >= 80 %}badge-low{% elif report.identity_score >= 50 %}badge-medium{% else %}badge-critical{% endif %}" style="font-size: 8.5pt; padding: 4px 12px;">
                    {{ score_band }}
                </span>
            </div>
            <div style="margin-top: 14px; font-size: 8pt; color: #64748b; line-height: 1.4;">
                {{ report.coverage_scope_note }}
            </div>
            <div style="margin-top: 8px; font-size: 7.5pt; color: #94a3b8; line-height: 1.4;">
                Scores and findings cover only the assessed modules above; runtime behaviour is not assessed.
            </div>
        </div>
    </div>

    <div style="display: table-cell; width: 64%; vertical-align: top; padding-left: 4px;">
        <div class="card" style="height: 100%; margin-bottom: 0; padding: 18px 20px;">
            <div style="font-size: 9pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #0f172a; margin-bottom: 12px;">
                Audited Agent Entities ({{ report.agents_found | length }})
            </div>
            <table class="data-table" style="margin-top: 0;">
                <thead>
                    <tr>
                        <th style="width: 35%;">Agent ID</th>
                        <th style="width: 35%;">Declared Role</th>
                        <th style="width: 30%;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for agent in report.agents_found %}
                    <tr>
                        <td><strong style="color: #0f172a;">{{ agent.agent_id }}</strong></td>
                        <td><code>{{ agent.declared_role or 'None' }}</code></td>
                        <td><span class="badge badge-neutral">Audited</span></td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="3" style="color: #94a3b8; text-align: center; padding: 16px;">No agent manifests found in target path.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==========================================
     DETAILED FINDINGS
     ========================================== -->
<div style="margin-bottom: 16px;">
    <div style="font-size: 13pt; font-weight: 800; color: #0f172a; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 16px;">
        Audit Findings Dossier ({{ report.findings | length }})
    </div>

    {% if report.findings %}
        {% for finding in report.findings %}
        <div class="card avoid-break" style="margin-bottom: 16px; border-left: 4px solid {% if finding.severity.value == 'CRITICAL' %}#dc2626{% elif finding.severity.value == 'HIGH' %}#ea580c{% elif finding.severity.value == 'MEDIUM' %}#d97706{% elif finding.severity.value == 'LOW' %}#16a34a{% else %}#0284c7{% endif %};">
            <div style="display: table; width: 100%; margin-bottom: 8px;">
                <div style="display: table-cell; vertical-align: middle;">
                    <span style="font-family: monospace; font-size: 9pt; font-weight: 700; color: #64748b;">{{ finding.attack_id }}</span>
                    <strong style="font-size: 11pt; color: #0f172a; margin-left: 8px;">{{ finding.attack_name }}</strong>
                </div>
                <div style="display: table-cell; vertical-align: middle; text-align: right;">
                    {% if finding.owasp_id %}
                    <span class="badge badge-neutral" style="margin-right: 6px;">{{ finding.owasp_id }}</span>
                    {% endif %}
                    <span class="badge badge-{{ finding.severity.value.lower() }}">{{ finding.severity.value }}</span>
                </div>
            </div>
            <div style="font-size: 9.5pt; color: #1e293b; margin-bottom: 10px; line-height: 1.45;">
                {{ finding.description }}
            </div>
            {% if finding.evidence %}
            <div style="margin-top: 10px;">
                <div style="font-size: 7.5pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; margin-bottom: 2px;">
                    Observed Manifest Evidence:
                </div>
                <pre class="code-block">{{ finding.evidence }}</pre>
            </div>
            {% endif %}
            {% if finding.remediation %}
            <div style="margin-top: 10px; padding: 10px 12px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px;">
                <div style="font-size: 7.5pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #0284c7; margin-bottom: 3px;">
                    Recommended Entitlement Hardening:
                </div>
                <div style="font-size: 8.5pt; color: #334155;">
                    {{ finding.remediation }}
                </div>
            </div>
            {% endif %}
        </div>
        {% endfor %}
    {% elif report.scope_complete and report.status == 'COMPLETE' %}
    <div class="card" style="text-align: center; padding: 36px 20px;">
        <div style="font-size: 28pt; color: #16a34a; margin-bottom: 8px;">✓</div>
        <div style="font-size: 12pt; font-weight: 700; color: #0f172a;">No Findings in the Full Audited Scope</div>
        <div style="font-size: 9pt; color: #64748b; margin-top: 4px;">
            Every selected static-audit module completed without findings. This does not establish runtime safety.
        </div>
    </div>
    {% elif report.status == 'COMPLETE' %}
    <div class="card" style="text-align: center; padding: 36px 20px;">
        <div style="font-size: 28pt; color: #16a34a; margin-bottom: 8px;">✓</div>
        <div style="font-size: 12pt; font-weight: 700; color: #0f172a;">No Findings in the Assessed Modules</div>
        <div style="font-size: 9pt; color: #64748b; margin-top: 4px;">
            Only {{ report.modules_ran | length }} of {{ report.audit_coverage | length }} coverage entries were assessed{% if report.modules_skipped %}; {{ report.modules_skipped | length }} module(s) were not selected{% endif %}. This is a partial result, not a clean bill of health.
        </div>
    </div>
    {% else %}
    <div class="card" style="text-align: center; padding: 36px 20px;">
        <div style="font-size: 22pt; color: #d97706; margin-bottom: 8px;">!</div>
        <div style="font-size: 12pt; font-weight: 700; color: #0f172a;">Assessment Inconclusive</div>
        <div style="font-size: 9pt; color: #64748b; margin-top: 4px;">
            No findings were recorded in the modules that ran, but the assessment is {{ report.status }}: {{ report.modules_skipped | length }} module(s) were not selected and {{ report.modules_errored | length }} errored. Review the coverage table before treating this as a clean result.
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
