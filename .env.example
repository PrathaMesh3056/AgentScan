# AgentScan — API keys for the AI attacker/judge (ATK-050).
# Copy this file to ".env" and paste your key(s). AgentScan loads .env automatically.
# .env is gitignored — your real keys are never committed.

# OpenRouter (recommended — hosts the Venice Uncensored / Dolphin models):
OPENROUTER_API_KEY=

# Optional — other providers (only if you use their models):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# DEEPINFRA_API_KEY=

# Local Ollama needs no key (models like ollama/dolphin3).
