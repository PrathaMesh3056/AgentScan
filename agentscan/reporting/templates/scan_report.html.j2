{% extends "base.html.j2" %}
{% block content %}
    <h1>AgentScan Report</h1>
    <h2>AgentScan Score: {{ report.score }} / 100</h2>

    <h3>Compliance Summary</h3>
    <ul>
        <li><strong>NIST Functions:</strong> {{ compliance_summary.nist_function | join(", ") }}</li>
        <li><strong>MITRE ATLAS Techniques:</strong> {{ compliance_summary.mitre_atlas_technique | join(", ") }}</li>
        <li><strong>EU AI Act Articles:</strong> {{ compliance_summary.eu_ai_act_article | join(", ") }}</li>
    </ul>

    <h3>Findings</h3>
    {% if report.findings %}
    <div class="findings-table">
        <div class="table-header">Attack ID</div>
        <div class="table-header">Severity</div>
        <div class="table-header">Description</div>

        {% for finding in report.findings %}
        <div>{{ finding.attack_id }}</div>
        <div class="severity-{{ finding.severity.value }}">{{ finding.severity.value }}</div>
        <div>
            {{ finding.description }}
            {% if finding.evidence %}
            <br><small><strong>Evidence:</strong> {{ finding.evidence }}</small>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% else %}
    <p>No findings to report.</p>
    {% endif %}
{% endblock %}
